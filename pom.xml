<?xml version="1.0" encoding="UTF-8" ?>
<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
>
  <modelVersion>4.0.0</modelVersion>

  <!-- Spring Boot 3.5.x: gestiona versiones de dependencias y plugins. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath />
  </parent>

  <groupId>com.intexus</groupId>
  <artifactId>backend-prueba-tecnica</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>backend-prueba-tecnica</name>
  <description
  >Sistema de Gestión de Vehículos - API REST con POO explícito y arquitectura de capas</description>

  <properties>
    <!-- Java 21 (Corretto): records, pattern matching, etc. -->
    <java.version>21</java.version>
  </properties>

  <dependencies>
    <!-- Capa controller: REST (Spring MVC) + Jackson (JSON polimórfico). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Capas service/repository: JPA + Hibernate (mapeo POO -> Table-per-Type). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Driver JDBC de MySQL (conector 8.x, compatible con caching_sha2). -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Pruebas (las crea la fase 04; esta dependencia es el estándar de Boot). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Integración (fase 04): Spring Boot Test + Testcontainers para levantar
         un MySQL 8.4 EFÍMERO con el MISMO esquema y seed de db/ (01-schema.sql
         y 02-seed.sql se montan en /docker-entrypoint-initdb.d). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mysql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Empaqueta el JAR ejecutable de la aplicación. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
